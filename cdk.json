{
  "app": "python3 app.py",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/__pycache__",
      "tests",
      ".venv",
      "build",
      "node_modules"
    ]
  },
  "context": {
    "githubRepo": "vinblue1977@13391763/CostWatcher@1425682336",
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:enablePartitionLiterals": true
  }
}
